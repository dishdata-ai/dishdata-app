# DishData (Next.js) — Supabase connection
# Copy to ".env.local" and fill in from Supabase dashboard → Project Settings → API.
# Leave unset to run in demo mode (localStorage data, no real auth).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Payments (Stripe Connect) ---------------------------------------------
# Use TEST keys (sk_test_… / pk_test_…) while building. Each restaurant connects
# its own Stripe account via Settings → Payments; charges are made on their
# account with a platform application fee.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From the Stripe CLI (`stripe listen --forward-connect-to localhost:3000/api/payments/webhook`)
# or the Dashboard webhook (listen to *connected account* events).
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Service-role key (Supabase → Project Settings → API). Used ONLY server-side by
# the webhook to mark orders paid. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin used to build Stripe redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Platform application fee in basis points (100 = 1%). 0 = take no fee.
PLATFORM_FEE_BPS=0
