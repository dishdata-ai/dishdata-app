{
  "expo": {
    "name": "DishData",
    "slug": "dishdata",
    "version": "1.0.0",
    "scheme": "dishdata",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dishdata.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "DishData uses the camera to scan barcodes and capture supplier bills.",
        "NSLocationWhenInUseUsageDescription": "DishData shares your location with customers while you're out on a delivery.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "DishData prints receipts to your restaurant’s printer on the local network."
      }
    },
    "android": {
      "package": "com.dishdata.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#08080d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "DishData uses the camera to scan barcodes and capture supplier bills."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DishData shares your location with customers while you're out on a delivery."
        }
      ],
      "with-rn-bluetooth-classic"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6cb5a73-365a-43a0-837f-0044d2c823d4"
      }
    },
    "owner": "dishdataais-team"
  }
}
